  <main class="docs-content">

    <div class="docs-intro">
      <h1>SvenTV API <span class="badge badge-primary">v2</span></h1>
      <p>API REST para listagem e acesso a canais de streaming M3U8. Autenticação via JWT, rate limiting por IP e token, e respostas em JSON.</p>
      <div class="badge-row">
        <span class="badge">REST</span>
        <span class="badge">JSON</span>
        <span class="badge badge-primary">JWT Auth</span>
        <span class="badge">Rate Limit</span>
      </div>
    </div>

    <!-- Introdução -->
    <section class="docs-section" id="introducao">
      <h2 class="docs-section-title">Visão Geral</h2>
      <p class="docs-section-desc">
        Base URL: <code>https://sventv.vercel.app</code><br>
        Todos os endpoints da API retornam JSON e estão sob o prefixo <code>/api</code>.
      </p>
      <div class="info-box info-box-primary">
        <span class="info-box-icon">ℹ️</span>
        Endpoints de canais exigem autenticação via API Token no header
        <code>Authorization: Bearer &lt;seu_api_token&gt;</code>. Rotas de admin exigem sessão de admin autenticada.
      </div>
    </section>

    <!-- Autenticação -->
    <section class="docs-section" id="autenticacao">
      <h2 class="docs-section-title">Autenticação</h2>
      <p class="docs-section-desc">
        A API usa dois tipos de token JWT:
        <strong>Session Token</strong> (para rotas web, expira em 7 dias) e
        <strong>API Token</strong> (para endpoints de canais, expira em 365 dias).
      </p>
      <div class="code-block">
        <div class="code-block-header">
          <span>Exemplo de requisição autenticada</span>
          <button class="code-copy-btn" data-copy>📋 Copiar</button>
        </div>
        <pre>curl https://sventv.vercel.app/api/channels \
  -H <span class="code-string">"Authorization: Bearer stv_xxxxxxxxxxxxxxxx"</span></pre>
      </div>
      <p class="docs-section-desc">
        Obtenha seu API Token após criar uma conta em <a href="/register" class="auth-link">/register</a> ou na página de <a href="/profile" class="auth-link">perfil</a>.
      </p>
    </section>

    <!-- Erros -->
    <section class="docs-section" id="erros">
      <h2 class="docs-section-title">Erros</h2>
      <p class="docs-section-desc">Todos os erros seguem o mesmo formato JSON:</p>
      <div class="code-block">
        <div class="code-block-header"><span>Formato de erro</span></div>
        <pre>{
  <span class="code-key">"success"</span>: <span class="code-bool">false</span>,
  <span class="code-key">"message"</span>: <span class="code-string">"Descrição do erro"</span>,
  <span class="code-key">"errors"</span>: [ <span class="code-comment">/* detalhe de validação (opcional) */</span> ]
}</pre>
      </div>
      <table class="params-table">
        <thead><tr><th>Código</th><th>Significado</th></tr></thead>
        <tbody>
          <tr><td><span class="status-badge status-2xx">200</span></td><td>Sucesso</td></tr>
          <tr><td><span class="status-badge status-2xx">201</span></td><td>Recurso criado</td></tr>
          <tr><td><span class="status-badge status-4xx">400</span></td><td>Requisição inválida</td></tr>
          <tr><td><span class="status-badge status-4xx">401</span></td><td>Token ausente ou inválido</td></tr>
          <tr><td><span class="status-badge status-4xx">403</span></td><td>Sem permissão</td></tr>
          <tr><td><span class="status-badge status-4xx">404</span></td><td>Recurso não encontrado</td></tr>
          <tr><td><span class="status-badge status-4xx">409</span></td><td>Conflito (ex: e-mail já cadastrado)</td></tr>
          <tr><td><span class="status-badge status-4xx">422</span></td><td>Erro de validação</td></tr>
          <tr><td><span class="status-badge status-4xx">429</span></td><td>Rate limit excedido</td></tr>
          <tr><td><span class="status-badge status-5xx">500</span></td><td>Erro interno do servidor</td></tr>
        </tbody>
      </table>
    </section>

    <!-- Rate Limiting -->
    <section class="docs-section" id="rate-limit">
      <h2 class="docs-section-title">Rate Limiting</h2>
      <table class="params-table">
        <thead><tr><th>Rota</th><th>Limite</th><th>Janela</th></tr></thead>
        <tbody>
          <tr><td>Global</td><td>200 req</td><td>1 minuto</td></tr>
          <tr><td>POST /api/auth/login</td><td>20 req</td><td>1 minuto</td></tr>
          <tr><td>POST /api/auth/register</td><td>10 req</td><td>1 minuto</td></tr>
          <tr><td>GET /api/channels/*</td><td>100 req</td><td>1 minuto</td></tr>
          <tr><td>GET /api/channels/:id/stream</td><td>50 req</td><td>1 minuto</td></tr>
        </tbody>
      </table>
      <div class="info-box info-box-warning">
        <span class="info-box-icon">⚠️</span>
        Ao exceder o limite, a API retorna <code>429 Too Many Requests</code>. O header
        <code>Retry-After</code> indica quantos segundos aguardar.
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--                  ENDPOINTS AUTH                        -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- POST /api/auth/register -->
    <section class="docs-section" id="ep-register">
      <h2 class="docs-section-title">POST /api/auth/register</h2>
      <div class="endpoint open">
        <div class="endpoint-header" onclick="this.parentElement.classList.toggle('open')">
          <span class="endpoint-method method-post">POST</span>
          <span class="endpoint-path">/api/auth/register</span>
          <span class="endpoint-summary">Registrar usuário</span>
          <span class="endpoint-toggle">▼</span>
        </div>
        <div class="endpoint-body">
          <p class="endpoint-desc">Cria conta e retorna session token + api token.</p>
          <h4>Body (JSON)</h4>
          <table class="params-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Obrig.</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td><span class="param-name">name</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td><td>Nome (3–100 chars)</td></tr>
              <tr><td><span class="param-name">email</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td><td>E-mail válido</td></tr>
              <tr><td><span class="param-name">password</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td><td>Mín. 8 caracteres</td></tr>
            </tbody>
          </table>
          <div class="code-block">
            <div class="code-block-header"><span>Resposta 201</span></div>
            <pre>{
  <span class="code-key">"success"</span>: <span class="code-bool">true</span>,
  <span class="code-key">"message"</span>: <span class="code-string">"Conta criada com sucesso"</span>,
  <span class="code-key">"sessionToken"</span>: <span class="code-string">"eyJhbGci..."</span>,
  <span class="code-key">"apiToken"</span>: <span class="code-string">"stv_xxxxxxxxxxxxxxxx"</span>,
  <span class="code-key">"user"</span>: { <span class="code-key">"id"</span>: <span class="code-string">"..."</span>, <span class="code-key">"name"</span>: <span class="code-string">"..."</span>, <span class="code-key">"email"</span>: <span class="code-string">"..."</span>, <span class="code-key">"plan"</span>: <span class="code-string">"free"</span> }
}</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- POST /api/auth/login -->
    <section class="docs-section" id="ep-login">
      <h2 class="docs-section-title">POST /api/auth/login</h2>
      <div class="endpoint">
        <div class="endpoint-header" onclick="this.parentElement.classList.toggle('open')">
          <span class="endpoint-method method-post">POST</span>
          <span class="endpoint-path">/api/auth/login</span>
          <span class="endpoint-summary">Autenticar usuário</span>
          <span class="endpoint-toggle">▼</span>
        </div>
        <div class="endpoint-body">
          <table class="params-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Obrig.</th></tr></thead>
            <tbody>
              <tr><td><span class="param-name">email</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td></tr>
              <tr><td><span class="param-name">password</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td></tr>
            </tbody>
          </table>
          <div class="info-box info-box-warning">
            <span class="info-box-icon">⚠️</span>
            Após 5 tentativas incorretas, a conta é bloqueada por 15 minutos.
          </div>
        </div>
      </div>
    </section>

    <!-- POST /api/auth/logout -->
    <section class="docs-section" id="ep-logout">
      <h2 class="docs-section-title">POST /api/auth/logout</h2>
      <div class="endpoint">
        <div class="endpoint-header" onclick="this.parentElement.classList.toggle('open')">
          <span class="endpoint-method method-post">POST</span>
          <span class="endpoint-path">/api/auth/logout</span>
          <span class="endpoint-summary">Encerrar sessão</span>
          <span class="endpoint-toggle">▼</span>
        </div>
        <div class="endpoint-body">
          <div class="info-box info-box-primary">
            <span class="info-box-icon">🔐</span>
            Requer header <code>Authorization: Bearer &lt;sessionToken&gt;</code>
          </div>
          <p class="endpoint-desc">Não há body. Encerra a sessão atual.</p>
        </div>
      </div>
    </section>

    <!-- GET /api/auth/profile -->
    <section class="docs-section" id="ep-profile">
      <h2 class="docs-section-title">GET /api/auth/profile</h2>
      <div class="endpoint">
        <div class="endpoint-header" onclick="this.parentElement.classList.toggle('open')">
          <span class="endpoint-method method-get">GET</span>
          <span class="endpoint-path">/api/auth/profile</span>
          <span class="endpoint-summary">Buscar perfil do usuário autenticado</span>
          <span class="endpoint-toggle">▼</span>
        </div>
        <div class="endpoint-body">
          <div class="info-box info-box-primary">
            <span class="info-box-icon">🔐</span>
            Requer header <code>Authorization: Bearer &lt;sessionToken&gt;</code>
          </div>
          <div class="code-block">
            <div class="code-block-header"><span>Resposta 200</span></div>
            <pre>{
  <span class="code-key">"success"</span>: <span class="code-bool">true</span>,
  <span class="code-key">"user"</span>: {
    <span class="code-key">"id"</span>: <span class="code-string">"..."</span>, <span class="code-key">"name"</span>: <span class="code-string">"..."</span>,
    <span class="code-key">"email"</span>: <span class="code-string">"..."</span>, <span class="code-key">"plan"</span>: <span class="code-string">"free"</span>,
    <span class="code-key">"apiToken"</span>: <span class="code-string">"stv_..."</span>, <span class="code-key">"createdAt"</span>: <span class="code-string">"..."</span>
  }
}</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- PUT /api/auth/profile -->
    <section class="docs-section" id="ep-profile-update">
      <h2 class="docs-section-title">PUT /api/auth/profile</h2>
      <div class="endpoint">
        <div class="endpoint-header" onclick="this.parentElement.classList.toggle('open')">
          <span class="endpoint-method method-put">PUT</span>
          <span class="endpoint-path">/api/auth/profile</span>
          <span class="endpoint-summary">Atualizar dados do perfil</span>
          <span class="endpoint-toggle">▼</span>
        </div>
        <div class="endpoint-body">
          <div class="info-box info-box-primary">
            <span class="info-box-icon">🔐</span>
            Requer header <code>Authorization: Bearer &lt;sessionToken&gt;</code>
          </div>
          <h4>Body (JSON)</h4>
          <table class="params-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Obrig.</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td><span class="param-name">name</span></td><td class="param-type">string</td><td><span class="param-optional">não</span></td><td>Novo nome (3–100 chars)</td></tr>
              <tr><td><span class="param-name">avatar</span></td><td class="param-type">string</td><td><span class="param-optional">não</span></td><td>URL do avatar</td></tr>
            </tbody>
          </table>
          <div class="code-block">
            <div class="code-block-header"><span>Resposta 200</span></div>
            <pre>{
  <span class="code-key">"success"</span>: <span class="code-bool">true</span>,
  <span class="code-key">"message"</span>: <span class="code-string">"Perfil atualizado com sucesso."</span>,
  <span class="code-key">"data"</span>: {
    <span class="code-key">"user"</span>: { <span class="code-key">"id"</span>: <span class="code-string">"..."</span>, <span class="code-key">"name"</span>: <span class="code-string">"Novo Nome"</span>, <span class="code-key">"email"</span>: <span class="code-string">"..."</span> }
  }
}</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- POST /api/auth/avatar -->
    <section class="docs-section" id="ep-avatar">
      <h2 class="docs-section-title">POST /api/auth/avatar</h2>
      <div class="endpoint">
        <div class="endpoint-header" onclick="this.parentElement.classList.toggle('open')">
          <span class="endpoint-method method-post">POST</span>
          <span class="endpoint-path">/api/auth/avatar</span>
          <span class="endpoint-summary">Upload de avatar (multipart/form-data)</span>
          <span class="endpoint-toggle">▼</span>
        </div>
        <div class="endpoint-body">
          <div class="info-box info-box-primary">
            <span class="info-box-icon">🔐</span>
            Requer header <code>Authorization: Bearer &lt;sessionToken&gt;</code>
          </div>
          <h4>Body (multipart/form-data)</h4>
          <table class="params-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Obrig.</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td><span class="param-name">avatar</span></td><td class="param-type">file</td><td><span class="param-required">sim</span></td><td>Imagem (máx. 5 MB)</td></tr>
            </tbody>
          </table>
          <div class="info-box info-box-warning">
            <span class="info-box-icon">⚠️</span>
            Formatos aceitos: JPEG, PNG, GIF, WebP. Máximo 5 MB.
          </div>
        </div>
      </div>
    </section>

    <!-- POST /api/auth/change-password -->
    <section class="docs-section" id="ep-change-password">
      <h2 class="docs-section-title">POST /api/auth/change-password</h2>
      <div class="endpoint">
        <div class="endpoint-header" onclick="this.parentElement.classList.toggle('open')">
          <span class="endpoint-method method-post">POST</span>
          <span class="endpoint-path">/api/auth/change-password</span>
          <span class="endpoint-summary">Alterar senha da conta</span>
          <span class="endpoint-toggle">▼</span>
        </div>
        <div class="endpoint-body">
          <div class="info-box info-box-primary">
            <span class="info-box-icon">🔐</span>
            Requer header <code>Authorization: Bearer &lt;sessionToken&gt;</code>
          </div>
          <h4>Body (JSON)</h4>
          <table class="params-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Obrig.</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td><span class="param-name">currentPassword</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td><td>Senha atual</td></tr>
              <tr><td><span class="param-name">newPassword</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td><td>Nova senha (mín. 8 chars)</td></tr>
              <tr><td><span class="param-name">confirmNewPassword</span></td><td class="param-type">string</td><td><span class="param-required">sim</span></td><td>Confirmação da nova senha</td></tr>
            </tbody>
          </table>
          <div class="code-block">
            <div class="code-block-header"><span>Resposta 200</span></div>
            <pre>{
  <span class="code-key">"success"</span>: <span class="code-bool">true</span>,
  <span class="code-key">"message"</span>: <span class="code-string">"Senha alterada com sucesso."</span>
}</pre>
          </div>
        </div>
      </div>
    </section>

    <!-- POST /api/auth/regenerate-token -->

{
  "version": 2,
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/internal/retention/run",
      "schedule": "0 3 * * *"
    }
  ],
  "builds": [
    {
      "src": "src/app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/app.js"
    }
  ]
}

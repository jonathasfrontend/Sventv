# ============================================================
# SvenTV API - Variáveis de Ambiente (Exemplo / Template)
# ============================================================
# Copie este arquivo como .env e preencha os valores reais.
# ============================================================

PORT=3000
NODE_ENV=development

# URL Postgres de conexão (Supabase > Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:senha@db.seu-projeto.supabase.co:5432/postgres?schema=public

# --- Supabase Storage (avatares)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUA_CHAVE_DE_SERVICO_AQUI"
SUPABASE_BUCKET_AVATARS="NOME_DO_BUCKET_AVATARS"

JWT_SECRET=mude_para_um_segredo_seguro_de_64_bytes_aqui_gerado_aleatoriamente
JWT_SESSION_EXPIRES_IN=7d

JWT_API_SECRET=outro_segredo_seguro_diferente_para_tokens_da_api_aqui
JWT_API_EXPIRES_IN=365d

# Playback token (curta duração, emitido por canal para o player).
# Se ausente, o segredo é derivado de JWT_API_SECRET (zero-config segura).
JWT_PLAYBACK_SECRET=segredo_dedicado_para_playback_tokens_opcional
PLAYBACK_TOKEN_EXPIRES_IN=2h

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GLOBAL=200
RATE_LIMIT_MAX_API=100
RATE_LIMIT_MAX_LOGIN=20
RATE_LIMIT_MAX_STREAM=50
RATE_LIMIT_MAX_REGISTER=10
# Limiter dedicado ao proxy HLS (segmentos não podem consumir a cota REST)
RATE_LIMIT_MAX_PROXY=1200

CACHE_TTL_CHANNELS=300
CACHE_TTL_CATEGORIES=600
CACHE_TTL_STATS=120

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

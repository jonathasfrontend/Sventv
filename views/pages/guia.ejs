<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head', { title: 'Guia de TV — SvenTV', cssFile: 'dashboard' }) %>
<link rel="stylesheet" href="/css/guia.css"></head>
<body>
<%- include('../partials/navbar', { user: locals.user, activePage: 'guia', epgEnabled: locals.epgEnabled }) %>
<%- include('../partials/flash') %>

<main class="dashboard-main guia-main">
  <div class="guia-header">
    <h1 class="guia-title">Guia de TV</h1>
  </div>

  <div class="dashboard-controls guia-controls">
    <div class="dashboard-search-wrap">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="search" id="guiaSearchInput" class="form-input search-input" placeholder="Buscar por canal ou programa..." autocomplete="off">
    </div>
    <select id="guiaCategoryFilter" class="form-input filter-select">
      <option value="">Todas as categorias</option>
    </select>
  </div>

  <div class="epg-scroll" id="epgScroll">
    <div class="epg-timeline" id="epgTimeline">
      <div class="epg-corner">Guia de TV</div>
    </div>
    <div id="epgRows" class="epg-rows"></div>
    <div class="epg-now-line" id="epgNowLine" hidden></div>
  </div>
  <div class="channels-empty" id="guiaEmpty" hidden>
    <p id="guiaEmptyMsg">🔍 Nenhum canal com programação nesta busca.</p>
    <button class="btn btn-ghost btn-sm" id="guiaClearBtn" type="button">Limpar filtros</button>
  </div>
  <div class="channels-empty" id="guiaError" hidden>
    <p>⚠️ Falha ao carregar o guia de programação.</p>
    <button class="btn btn-ghost btn-sm" id="guiaRetryLoad" type="button">Tentar novamente</button>
  </div>
</main>

<!-- ── Modal de detalhes do programa ─────────────────────────── -->
<div class="modal-overlay" id="guiaDetailModal" hidden>
  <div class="modal-container">
    <div class="modal-header">
      <div class="modal-channel-info">
        <img class="modal-logo" id="dgLogo" src="" alt="" onerror="this.style.display='none'">
        <div>
          <h3 class="modal-title" id="dgChannelName">Canal</h3>
          <span class="badge" id="dgCategory"></span>
        </div>
      </div>
      <div class="modal-actions">
        <button class="modal-close" id="dgClose" aria-label="Fechar">✕</button>
      </div>
    </div>
    <div class="modal-body dg-body">
      <div class="dg-tag" id="dgTag"></div>
      <h2 class="dg-title" id="dgTitle">—</h2>
      <p class="dg-time" id="dgTime">—</p>
      <p class="dg-duration" id="dgDuration"></p>
      <p class="dg-desc" id="dgDesc"></p>
      <div class="dg-actions">
        <button class="btn btn-primary" id="dgWatchBtn" type="button">▶ Assistir ao vivo</button>
      </div>
    </div>
  </div>
</div>

<!-- ── Modal Player ───────────────────────────────────────────── -->
<div class="modal-overlay" id="guiaPlayerModal" hidden>
  <div class="modal-container">
    <div class="modal-header">
      <div class="modal-channel-info">
        <img class="modal-logo" id="guiaModalLogo" src="" alt="" onerror="this.style.display='none'">
        <div>
          <h3 class="modal-title" id="guiaModalTitle">Canal</h3>
          <span class="badge" id="guiaModalCategory"></span>
        </div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost btn-sm" id="guiaModalNow">Carregando...</button>
        <button class="modal-close" id="guiaModalClose" aria-label="Fechar">✕</button>
      </div>
    </div>
    <div class="modal-player-wrap">
      <iframe id="guiaPlayerFrame" class="player-iframe" src="about:blank" allowfullscreen
        allow="autoplay; fullscreen; picture-in-picture" frameborder="0" scrolling="no" title="Player SvenTV"></iframe>
      <div class="player-error" id="guiaPlayerError" hidden>
        <span>⚠️</span>
        <p>Canal não disponível ou ID inválido.</p>
        <button class="btn btn-ghost btn-sm" id="guiaRetryBtn">Tentar novamente</button>
      </div>
    </div>
  </div>
</div>

<!-- Dados do usuário para o JS (data island — mesmo padrão do dashboard) -->
<script type="application/json" id="__USER_DATA__"><%- JSON.stringify({
  name:     locals.user ? locals.user.name : null,
  apiToken: locals.user ? locals.user.apiToken : null,
  epgEnabled: locals.epgEnabled
}) %></script>
<%- include('../partials/footer') %>
<script src="/js/realtime.js"></script>
<script src="/js/guia.js"></script>
</body>
</html>
# ============================================================
# SvenTV API - Variáveis de Ambiente (Exemplo / Template)
# ============================================================
# Copie este arquivo como .env e preencha os valores reais.
# ============================================================

PORT=3000
NODE_ENV=development

# URL pública da aplicação — usada nos e-mails transacionais para montar o
# link de redefinição de senha. Vazia = e-mail sem link (só instrução em texto).
APP_BASE_URL=http://localhost:3000
# Fuso usado para exibir horários em e-mails transacionais (lembretes).
APP_TIMEZONE=America/Sao_Paulo
# IMPORTANTE: use a URL certa por ambiente (Project Settings > Database).
#
# DESENVOLVIMENTO LOCAL — conexão direta ou session pooler (:5432):
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
#
# PRODUÇÃO (VERCEL) — TRANSACTION POOLER (:6543), obrigatório para
# serverless. O client adiciona ?pgbouncer=true&connection_limit=1
# automaticamente; sem isso o pooler session mode estoura
# (FATAL EMAXCONNSESSION, pool_size 15):
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://postgres:<senha>@db.seu-projeto.supabase.co:5432/postgres?schema=public"

# Usada APENAS pela CLI do Prisma (migrate deploy/generate). Aponte para
# a conexão direta/session pooler — NUNCA para a :6543:
DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# ════ Desenvolvimento local (Docker) — ALTERNATIVA ao Supabase/Upstash ════
# Use `docker compose up -d` (Postgres 16 + Redis 7 + proxy) para rodar e
# testar localmente SEM depender de Supabase/Upstash. Produção NÃO muda:
# continua em Supabase (pooler :6543) + Upstash, exatamente como acima.
# A troca é só de variável de ambiente — bata este bloco sobre o .env
# (os valores abaixo sobrescrevem DATABASE_URL/DIRECT_URL/UPSTASH_REDIS_*).
# Credenciais sventv/sventv_dev_only são APENAS locais/descartáveis.
#
# Postgres local (Docker) — processo único, sem pooler; a lógica de
# pgbounger/connection_limit só entra com porta 6543 ou VERCEL=1, então
# aqui a DATABASE_URL é uma conexão direta comum (:5432).
# DATABASE_URL="postgresql://sventv:sventv_dev_only@localhost:5432/sventv"
# DIRECT_URL="postgresql://sventv:sventv_dev_only@localhost:5432/sventv"
#
# Redis local via serverless-redis-http (proxy HTTP compatível com a
# UPSTASH REST API — o redisStore.js NÃO muda nenhuma linha). Em vez de
# apontar para o Upstash de verdade, aponta para o container na 8079.
# UPSTASH_REDIS_REST_URL="http://localhost:8079"
# UPSTASH_REDIS_REST_TOKEN="local-dev-token"
# DISTRIBUTED_STATE_ENABLED=true

JWT_SECRET=mude_para_um_segredo_seguro_de_64_bytes_aqui_gerado_aleatoriamente
JWT_SESSION_EXPIRES_IN=7d

JWT_API_SECRET=outro_segredo_seguro_diferente_para_tokens_da_api_aqui
JWT_API_EXPIRES_IN=365d

# Playback token (curta duração, emitido por canal para o player).
# Se ausente, o segredo é derivado de JWT_API_SECRET (zero-config segura).
JWT_PLAYBACK_SECRET=segredo_dedicado_para_playback_tokens_opcional
PLAYBACK_TOKEN_EXPIRES_IN=2h

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GLOBAL=200
RATE_LIMIT_MAX_API=100
RATE_LIMIT_MAX_LOGIN=20
RATE_LIMIT_MAX_STREAM=50
RATE_LIMIT_MAX_REGISTER=10
RATE_LIMIT_MAX_USER=120
RATE_LIMIT_MAX_EVENTS=600
# Limiter dedicado ao proxy HLS (segmentos não podem consumir a cota REST)
RATE_LIMIT_MAX_PROXY=1200
# Janela própria do proxy HLS (não disputa a cota REST/global).
RATE_LIMIT_PROXY_WINDOW_MS=60000
# Ações administrativas de escrita (role/block/profile/password/avatar/delete)
# — cota por admin autenticado; GETs não consomem.
RATE_LIMIT_MAX_ADMIN_WRITE=60
RATE_LIMIT_ADMIN_WRITE_WINDOW_MS=900000

# Limite de streams HLS ATIVOS simultâneos por usuário (em memória, por lambda)
# e TTL de cada vaga. Mitigação parcial no serverless (documentado).
# Não usar 1: a vaga é tomada a cada reload do manifesto e o HLS.js sobrepõe
# requisições (reload + retry + troca de nível de ABR) — o próprio usuário se
# trancava. 3 acomoda uma sessão com troca de qualidade.
STREAM_MAX_ACTIVE=3
STREAM_SLOT_TTL_MS=300000

# --- Health / Failover automático de fontes (em memória, por lambda) ---
# Intervalo entre ciclos de checagem de saúde (ms).
HEALTH_CHECK_INTERVAL_MS=60000
# Timeout de cada request de verificação (ms).
HEALTH_REQUEST_TIMEOUT_MS=8000
# Nº de falhas consecutivas da fonte ativa para acionar o failover.
HEALTH_FAILOVER_THRESHOLD=2
# Tempo mínimo (ms) na fonte backup antes de tentar voltar à primária.
HEALTH_FAILBACK_MIN_MS=120000

CACHE_TTL_CHANNELS=300
CACHE_TTL_CATEGORIES=600
CACHE_TTL_STATS=120
# Cache por usuário (recomendações) e da dashboard.
CACHE_TTL_RECOMMENDATIONS=600
CACHE_TTL_DASHBOARD=60

# --- Trending ("Ao vivo em alta" — catálogo externo de metadados) ---
# URL do GraphQL do provedor de catálogo (programações ao vivo em alta).
# Segue o mesmo princípio do EPG: nunca logada; cache em memória + fail-open.
TRENDING_API_URL=https://metadatadb.lab.smartcontent.clarobrasil.mobi/graphql
# Kill switch da feature — false desliga o carrossel "Ao vivo em alta" sem deploy.
TRENDING_ENABLED=true
# TTL do cache em memória (30 min por padrão) e timeout do fetch.
TRENDING_CACHE_TTL_MS=1800000
TRENDING_FETCH_TIMEOUT_MS=10000

# --- EPG (Guia de Canais — XMLTV em memória) ---
# URL do XMLTV. SEGREDO OPERACIONAL: nunca é logada nem exposta ao cliente
# (mesmo princípio da URL M3U upstream).
EPG_URL=
# Kill switch da feature — false desliga rotas/página do guia sem deploy.
EPG_ENABLED=true
# TTL do cache em memória (30 min por padrão) e timeout do fetch do XML.
EPG_CACHE_TTL_MS=1800000
EPG_FETCH_TIMEOUT_MS=10000

# ── Avise-me (lembretes de programação — program_reminders) ────
# Lembrete = "me avise quando o programa do EPG começar". Persistido em
# Postgres (program_reminders). Dois canais de entrega independentes (sem
# duplicar — notifiedAt fecha o ciclo de quem marcar primeiro):
#   1) frontend — browser Notification API via dispatcher compartilhado
#      public/js/reminder-notifier.js (polling mesmo com a aba em segundo plano:
#      janela [agora−trail, agora+lead]; trail e lead são configurados no
#      cliente, servidor aceita ?trail= clamp 0..30min);
#   2) servidor — cron de e-mail a cada 5 min (POST /api/internal/reminders/run)
#      via SMTP para lembretes com início dentro de REMINDERS_DUE_WINDOW_MS.
# O serviço NUNCA envia push com a página fechada, exceto o e-mail agendado.
# Kill switch: REMINDERS_ENABLED=false → rotas respondem 400 FEATURE_DISABLED
# e o botão/badge some no frontend (sem novo deploy).
REMINDERS_ENABLED=true
# Máx. lembretes ativos por usuário (422 quando estourar).
REMINDERS_MAX_PER_USER=50
# Horizonte máximo à frente aceito (ms) — padrão 24h (e-mail agendado pelo
# cron; horizontes longos criariam estado morto no banco).
REMINDERS_MAX_HORIZON_MS=86400000
# Cron de e-mail: janela "vence agora" (ms) + lote máximo por execução.
REMINDERS_DUE_WINDOW_MS=300000
REMINDERS_BATCH_LIMIT=50

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15

# ── Política de senha ────────────────────────────────────────────────
# Mínimo de caracteres (mantido 8 pela política existente).
PASSWORD_MIN_LENGTH=8
# Máximo de BYTES UTF-8 aceitos (bcrypt trunca em 72 bytes — acima gera colisão silenciosa).
PASSWORD_MAX_BYTES=72

# ── SMTP (e-mails transacionais) ─────────────────────────────────────
# Se SMTP_HOST não for configurado, o e-mail de recuperação NÃO é enviado
# (loga aviso interno, fluxo segue genérico). Nunca exponha SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Recuperação de senha ─────────────────────────────────────────────
# Validade do código (15 min). Máx. 5 tentativas antes de invalidar.
PASSWORD_RESET_CODE_TTL_MS=900000
PASSWORD_RESET_MAX_ATTEMPTS=5
# Rate limit: 3 requisições por e-mail+IP a cada 15 min.
PASSWORD_RESET_FORGOT_WINDOW_MS=900000
PASSWORD_RESET_FORGOT_MAX=3
# Rate limit: 10 requisições por IP a cada 15 min (anti brute-force distribuído).
PASSWORD_RESET_RESET_WINDOW_MS=900000
PASSWORD_RESET_RESET_MAX=10

# ── Termos de Uso ───────────────────────────────────────────────────
# Versão centralizada (data de vigência). Atualizar ao mudar o conteúdo de /termos.
TERMS_VERSION=2026-09-16

# ── Upstash Redis (rate limiting distribuído) ────────────────────────
# Opcional. Se não configurado, o rate limiting usa memória local (por lambda).
# Upstash Redis REST API — https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Kill switch do estado distribuído — false devolve tudo ao modo em memória
# (rollback lógico sem novo deploy).
DISTRIBUTED_STATE_ENABLED=true
# TTL do cache local de disponibilidade do Redis (ms) — evita healthcheck por request.
REDIS_AVAILABILITY_CACHE_MS=30000

# ── Channel State (Postgres + cache local) ────────────────────
# Estado administrativo de canal (live/maintenance/blocked) é persistido
# em Postgres (tabela channel_states) e lido via cache local com TTL.
# Kill switch: false devolve ao comportamento 100% em memória (sem
# hidratar/persistir) — rollback lógico sem novo deploy.
CHANNEL_STATE_PERSIST_ENABLED=true
# TTL do cache local do estado administrativo de canal (ms).
CHANNEL_STATE_CACHE_TTL_MS=8000

# ── Channel Health (failover persistido — channel_health) ────
# A fonte ativa (primary|backup) na última TROCA é persistida em Postgres
# para sobreviver a cold start. O ciclos de checagem continuam em memória;
# a tabela só sofre escrita quando há uma TRANSIÇÃO de fonte (nunca em
# checks normais). Kill switch: false → 100% em memória (sem hidratar).
CHANNEL_HEALTH_PERSIST_ENABLED=true

# ── Retenção de dados operacionais ────────────────────────────
# Limpeza de tabelas operacionais que crescem: request_usage (buckets de
# rate limit) e audit_logs (trilha). 0 desativa a limpeza daquele tipo.
# Execução: cron da Vercel (posteriormente "/api/internal/retention/run",
# diariamente 03:00) e manual em POST /api/admin/retention/run.
REQUEST_USAGE_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90

# ── Jobs internos (Vercel Cron) ───────────────────────────────
# Segredo compartilhado enviado pelo cron (Authorization: Bearer ou
# X-Cron-Secret). NUNCA logar/expor. Vazio = rotas internas desligadas.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Alertas operacionais (admin) ──────────────────────────────
# Notificações de eventos operacionais (failover/failback, SMTP fora,
# Redis em fallback) E de eventos de usuário (registro, bloqueio por
# tentativas, teto de tentativas de reset, promoção a admin, exclusão de
# conta, rate limit de registro). Vai por e-mail (ADMIN_ALERT_EMAIL) e/ou
# webhook (ALERT_WEBHOOK_URL — payload {text} p/ Slack/genéricos; {content}+
# {embeds} p/ webhooks do Discord, detectado por host+path — {text} no
# Discord dá HTTP 400). E-mail de alerta usa HTML com design (título/emoji/
# cor/categoria por evento em EVENT_META no alertService) + fallback texto.
# A URL do webhook é SEGREDO: nunca logar/expor. Cooldown entre envios
# do MESMO evento (ms), válido por lambda (serverless não tem timer único).
# Regra de eventKey: sistema=genérica; usuário=por user id; ação admin
# única (promoção/exclusão)=user id+timestamp (nunca engolidas); rate
# limit=genérica. Payload só com ids/nomes/e-mails — nunca senha/token/segredo.
ALERTS_ENABLED=true
ADMIN_ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=1800000
# --- Redis extra (tooling) ---
# NÃO é lido pelo código: o app usa Upstash REST (UPSTASH_REDIS_REST_URL/REST_TOKEN).
REDIS_URL=
# Canal de e-mail do Avise-me (enviado pelo cron /api/internal/reminders/run).
# Vercel Hobby: 1 cron/dia (dedicado à retenção) -> setar false e usar SÓ a Notification
# do navegador. Dev (npm run reminders:run) mantém true.
REMINDERS_EMAIL_ENABLED=true

# ── Segurança (WAF, Google OAuth) ───────────────────────────
# WAF (middleware de monitoramento/bloqueio): IPs manualmente bloqueados,
# vírgula-separada. Sem esta lista o WAF apenas monitora (e bloqueia por
# limites automáticos de frequência).
WAF_BLOCKED_IPS=

# ── IP Access Control (blocklist WAF persistente) ────────────
# Blocklist de IPs persistida em `ip_blocklist` (tabela nova) + captura do
# IP real no cadastro (`users.registration_ip`). IP bloqueado → 403 em toda
# a API (menos /health/estáticos). Fonte de verdade = Postgres; cache em
# memória por lambda (TTL IP_ACCESS_CACHE_TTL_MS, 10s) com read-through e
# fail-open (banco fora → libera). Kill switch:
IP_ACCESS_ENABLED=true
IP_ACCESS_CACHE_TTL_MS=10000
# Retenção do histórico de ip_blocklist JÁ DESBLOQUEADO (active=false). 0 =
# desativa (padrão, mantém o histórico). Bloqueios ATIVOS nunca são apagados.
IP_BLOCKLIST_RETENTION_DAYS=0

# Google reCAPTCHA v2 — chaves mantidas por compatibilidade (não utilizadas).
# O CAPTCHA foi removido do login/registro/recuperação de senha.
# https://www.google.com/recaptcha/admin
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Google OAuth (botão "Continuar com Google" em login/registro e vínculo da
# conta no perfil). GOOGLE_CLIENT_SECRET é SEGREDO — nunca logar/expor.
# GOOGLE_REDIRECT_URI é a rota que recebe o GET do Google após o
# consentimento:
#   - /api/google/callback (padrão — login concluído no servidor);
#   - ou uma página do frontend (ex.: /login) que troca code+state via
#     POST /api/google/login (o CSRF state é validado no servidor de todo
#     jeito; a página enviará o par code/state automaticamente).
# Credenciais: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
